# Device mode: auto|cpu|gpu|cuda
DEVICE_MODE=auto

# Optional Hugging Face token (for private/gated repos)
HF_TOKEN=

# Optional upstream OpenAI-compatible chat backend (for /v1/chat/completions)
# Example: http://localhost:11434/v1  or  http://localhost:8000/v1
LLM_PROXY_BASE_URL=
LLM_PROXY_API_KEY=
LLM_PROXY_TIMEOUT_SEC=120

# Model listing scope (admin UI, /admin/models, /v1/models, /models): comma-separated
# directories under MODEL_DIR (absolute allowed). The first root is where catalog models are saved.
ADMIN_MODEL_ROOTS=embedding

# Optional per-runtime overrides; built-in profiles supply model-specific prefixes,
# remote-code settings and EG2 text-only loading. Gemma requires BF16/FP32, never FP16.
SENTENCE_TRANSFORMER_KWARGS=
CROSS_ENCODER_KWARGS=

# Optional catalog override (array of repo_id / family / type; local_name for custom save names).
# A catalog row alone does not add a new inference engine.
MODEL_CATALOG_JSON=
