# systemd EnvironmentFile 用。コピー先で環境に合わせて編集する。
HOME="/var/lib/embedding-api"
PYTHONUNBUFFERED="1"
HF_HOME="/var/cache/embedding-api/huggingface"
MODEL_DIR="/var/lib/embedding-api/models"
DEVICE_MODE="auto"
AUTO_LOAD="1"
IDLE_TTL="6000"
PRELOAD_EMBEDDING=""
PRELOAD_RERANKER=""
VIRTUAL_ENV="/opt/embedding-api/venv"
HOST="0.0.0.0"
PORT="7997"
PATH="/opt/embedding-api/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
